{
	"Name": "JBxHeadsetControl",
	"Version": "2.0.0.0",
	"Author": "holgermilz",
	"Actions": [
		{
			"Name": "Mute",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.mute",
			"Icon": "imgs/actions/mute/icon",
			"PropertyInspectorPath": "ui/mute.html",
			"Tooltip": "Toggle microphone mute",
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/mute/live",
					"Name": "Live",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/actions/mute/muted",
					"Name": "Muted",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/actions/mute/offline",
					"Name": "Offline",
					"TitleAlignment": "middle"
				},
				{
					"Image": "imgs/actions/mute/nodongle",
					"Name": "No Dongle",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "ANC / Ambient",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.anc",
			"Icon": "imgs/actions/anc/icon",
			"Tooltip": "Cycle Off / Noise Cancelling / Ambient Aware",
			"PropertyInspectorPath": "ui/anc.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/anc/icon",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Spatial Sound",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.spatial",
			"Icon": "imgs/actions/spatial/icon",
			"Tooltip": "Cycle spatial sound mode",
			"PropertyInspectorPath": "ui/spatial.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/spatial/icon",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Battery",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.battery",
			"Icon": "imgs/actions/battery/icon",
			"Tooltip": "Shows headset battery level",
			"PropertyInspectorPath": "ui/battery.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/battery/icon",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Game-Chat Balance",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.chatbalance",
			"Icon": "imgs/actions/chatbalance/icon",
			"Tooltip": "Adjust game/chat audio balance",
			"PropertyInspectorPath": "ui/chatbalance.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/chatbalance.json",
				"TriggerDescription": {
					"Rotate": "Adjust balance",
					"Push": "Reset to 50/50"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/chatbalance/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "EQ Preset",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.eqkey",
			"Icon": "imgs/actions/eq/icon",
			"Tooltip": "Apply an EQ preset from QuantumENGINE",
			"PropertyInspectorPath": "ui/eq.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/eq/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "EQ Preset Dial",
			"UUID": "com.holgermilz.myjbxheadsetcontrol.eqdial",
			"Icon": "imgs/actions/eqdial/icon",
			"Tooltip": "Rotate to choose an EQ preset, press to apply",
			"PropertyInspectorPath": "ui/eqdial.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/eqdial.json",
				"TriggerDescription": {
					"Rotate": "Choose preset",
					"Push": "Apply",
					"Touch": "Apply"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/eqdial/key",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "JBxHeadsetControl",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Controls mute, ANC, Ambient Aware, spatial sound, game-chat balance and EQ presets on the JBL Quantum 950, with live battery status.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.holgermilz.myjbxheadsetcontrol"
}